#. module: om_PO_repeat_periodically
msgid "Repeat periodically"
msgstr "Repetir periódicamente"

#. module: om_PO_repeat_periodically
msgid "Repeat every"
msgstr "Repetir cada"

#. module: om_PO_repeat_periodically
msgid "Period"
msgstr "Periodo"

#. module: om_PO_repeat_periodically
msgid "Day(s)"
msgstr "Día(s)"

#. module: om_PO_repeat_periodically
msgid "Week(s)"
msgstr "Semana(s)"

#. module: om_PO_repeat_periodically
msgid "Month(s)"
msgstr "Mes(es)"

#. module: om_PO_repeat_periodically
msgid "Year(s)"
msgstr "Año(s)"

#. module: om_PO_repeat_periodically
msgid "Next creation date"
msgstr "Siguiente fecha de creación"

#. module: om_PO_repeat_periodically
msgid "Recurring source order"
msgstr "Orden recurrente de origen"

#. module: om_PO_repeat_periodically
msgid "Generated recurring instance"
msgstr "Instancia recurrente generada"

#. module: om_PO_repeat_periodically
msgid "Identifies orders created automatically or manually from a recurring source."
msgstr "Identifica las órdenes creadas automática o manualmente desde un origen recurrente."

#. module: om_PO_repeat_periodically
msgid "Generated orders"
msgstr "Órdenes generadas"

#. module: om_PO_repeat_periodically
msgid "Generated orders count"
msgstr "Cantidad de órdenes generadas"

#. module: om_PO_repeat_periodically
msgid "Generated Orders"
msgstr "Órdenes generadas"

#. module: om_PO_repeat_periodically
msgid "Periodic Repetition"
msgstr "Repetición periódica"

#. module: om_PO_repeat_periodically
msgid "Schedule"
msgstr "Programación"

#. module: om_PO_repeat_periodically
msgid "Source"
msgstr "Origen"

#. module: om_PO_repeat_periodically
msgid "Generate Now"
msgstr "Generar ahora"

#. module: om_PO_repeat_periodically
msgid "Generated Purchase Order"
msgstr "Orden de compra generada"

#. module: om_PO_repeat_periodically
msgid "The repetition interval must be greater than zero."
msgstr "El intervalo de repetición debe ser mayor que cero."

#. module: om_PO_repeat_periodically
msgid "Set the next creation date before enabling repetition."
msgstr "Indique la siguiente fecha de creación antes de activar la repetición."

#. module: om_PO_repeat_periodically
msgid "A recurring purchase order must have at least one order line."
msgstr "Una orden de compra recurrente debe tener al menos una línea."

#. module: om_PO_repeat_periodically
msgid "A cancelled purchase order cannot be repeated."
msgstr "Una orden de compra cancelada no se puede repetir."

#. module: om_PO_repeat_periodically
msgid "An order generated from another order cannot be repeated again."
msgstr "Una orden generada desde otra orden no se puede volver a repetir."

#. module: om_PO_repeat_periodically
msgid "Purchase Orders: generate recurring orders"
msgstr "Órdenes de compra: generar órdenes recurrentes"

#. module: om_PO_repeat_periodically
msgid "Generated orders are created as drafts. Standard purchase data and every required field, including fields from custom modules, are copied. Generated instances cannot repeat themselves."
msgstr "Las órdenes generadas se crean en borrador. Se copian los datos estándar de compras y todos los campos obligatorios, incluidos los campos de módulos personalizados. Las instancias generadas no pueden repetirse a sí mismas."
